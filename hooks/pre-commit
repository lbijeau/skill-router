#!/usr/bin/env bash
set -euo pipefail
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed — secrets scanning cannot run." >&2
  echo "  brew install gitleaks   (or: go install github.com/gitleaks/gitleaks/v8@latest)" >&2
  exit 1
fi
exec gitleaks protect --staged --no-banner --redact
